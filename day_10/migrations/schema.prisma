// =====================================================================
// Day 10: Prisma Schema berdasarkan struktur day_10/object.js
// Jalankan migrasi: npx prisma migrate dev --name init_products
// Generate client: npx prisma generate
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------
// PILIHAN A: Jika menggunakan Database Relasional (PostgreSQL / MySQL / SQLite)
// ---------------------------------------------------------------------
datasource db {
  provider = "postgresql" // ganti dengan "mysql" atau "sqlite" jika diperlukan
  url      = env("DATABASE_URL")
}

model Product {
  id        Int      @id @default(autoincrement())
  nama      String
  harga     Int
  stok      Int      @default(0)
  kategori  String   @default("Umum")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

